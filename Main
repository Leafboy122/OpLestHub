local globalList = Instance.new("ScrollingFrame")
globalList.Size = UDim2.new(1, -16, 1, -85)
globalList.Position = UDim2.new(0, 8, 0, 80)
globalList.BackgroundTransparency = 1
globalList.BorderSizePixel = 0
globalList.ScrollBarThickness = 3
globalList.ZIndex = 21
globalList.Parent = globalFrame

local globalLayout = Instance.new("UIListLayout")
globalLayout.Padding = UDim.new(0, 4)
globalLayout.Parent = globalList

--// Containers visible to the client
local containers = {
	workspace,
	ReplicatedStorage,
	ReplicatedFirst,
	StarterGui,
	StarterPack,
	StarterPlayer,
}

--// Clear global results
local function clearGlobalResults()
	for _, child in ipairs(globalList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

--// Global search
local function globalSearchRefresh()
	clearGlobalResults()

	local query = globalSearch.Text:lower()

	if query == "" then
		return
	end

	local results = {}
	local seen = {}

	for _, container in ipairs(containers) do
		local descendants = container:GetDescendants()

		for _, obj in ipairs(descendants) do
			local name = obj.Name

			if name:lower():find(query, 1, true) then
				if not seen[obj] then
					seen[obj] = true
					table.insert(results, obj)
				end
			end
		end
	end

	for _, obj in ipairs(results) do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -4, 0, 42)
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

		local path = obj:GetFullName()

		button.Text = obj.Name .. "\n" .. path
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 11
		button.Font = Enum.Font.Gotham
		button.TextWrapped = true
		button.ZIndex = 22
		button.Parent = globalList

		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

		button.MouseButton1Click:Connect(function()
			-- Add actual Instance to selectable list
			globalInstances[obj] = obj

			globalFrame.Visible = false

			-- Refresh main list
			refresh()
		end)
	end

	task.wait()

	globalList.CanvasSize = UDim2.new(
		0,
		0,
		0,
		globalLayout.AbsoluteContentSize.Y + 5
	)
end

--// Main list refresh
function refresh()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local search = searchBox.Text:lower()
	local seenNames = {}

	-- Interactables
	for _, obj in ipairs(interactables:GetChildren()) do
		local name = obj.Name

		if not seenNames[name] then
			seenNames[name] = true

			if search == "" or name:lower():find(search, 1, true) then
				local button = Instance.new("TextButton")
				button.Size = UDim2.new(1, -4, 0, 34)
				button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
				button.Text = name
				button.TextColor3 = Color3.new(1, 1, 1)
				button.TextSize = 13
				button.Font = Enum.Font.Gotham
				button.Parent = list

				Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

				button.MouseButton1Click:Connect(function()
					Event:FireServer("Mix", obj, 2)
				end)
			end
		end
	end

	-- Global selected Instances
	for obj, selected in pairs(globalInstances) do
		if selected and selected.Parent then
			local name = selected.Name

			if search == "" or name:lower():find(search, 1, true) then
				local button = Instance.new("TextButton")
				button.Size = UDim2.new(1, -4, 0, 34)
				button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
				button.Text = name
				button.TextColor3 = Color3.new(1, 1, 1)
				button.TextSize = 13
				button.Font = Enum.Font.Gotham
				button.Parent = list

				Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

				button.MouseButton1Click:Connect(function()
					Event:FireServer("Mix", selected, 2)
				end)
			end
		end
	end

	task.wait()

	list.CanvasSize = UDim2.new(
		0,
		0,
		0,
		layout.AbsoluteContentSize.Y + 5
	)
end

--// Open global search
gear.MouseButton1Click:Connect(function()
	globalFrame.Visible = not globalFrame.Visible

	if globalFrame.Visible then
		globalSearch:CaptureFocus()
	end
end)

closeGlobal.MouseButton1Click:Connect(function()
	globalFrame.Visible = false
end)

globalSearchButton.MouseButton1Click:Connect(globalSearchRefresh)

globalSearch.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		globalSearchRefresh()
	end
end)

--// Main search
searchButton.MouseButton1Click:Connect(refresh)

searchBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		refresh()
	end
end)

--// Minimize
local minimized = false
local normalSize = main.Size

minimize.MouseButton1Click:Connect(function()
	minimized = not minimized

	if minimized then
		content.Visible = false
		main.Size = UDim2.new(0, 240, 0, 35)
		minimize.Text = "+"
	else
		content.Visible = true
		main.Size = normalSize
		minimize.Text = "-"
	end
end)

--// Main UI dragging
local dragging = false
local dragStart
local startPosition

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

refresh()
