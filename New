--==================================================
-- SHAKER STATE
--==================================================

local shakerAnimationPlaying =
	false

local shakerTracks =
	{}

-- Counts every time the shaker animation starts.
-- This lets the mixer detect an animation that begins
-- AFTER an ingredient was already sent.
local shakerStartCounter =
	0

--==================================================
-- ANIMATION CHECK
--==================================================

local function isShakerAnimation(track)

	if not track then
		return false
	end

	local animation =
		track.Animation

	if not animation then
		return false
	end

	return animation.AnimationId ==
		MIX_ANIMATION_ID

end

--==================================================
-- CLEAR SHAKER STATE
--==================================================

local function clearShakerTrack(track)

	shakerTracks[track] =
		nil

	local anotherTrack =
		false

	for activeTrack in pairs(
		shakerTracks
	) do

		if activeTrack
			and activeTrack.IsPlaying then

			anotherTrack =
				true

			break

		end

	end

	if not anotherTrack then

		shakerAnimationPlaying =
			false

		print(
			"[Poke Haven Mix Hub] Shaker animation FINISHED."
		)

	end

end

--==================================================
-- WATCHER
--==================================================

local function setupAnimationWatcher(character)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then

		humanoid =
			character:WaitForChild(
				"Humanoid"
			)

	end

	table.clear(
		shakerTracks
	)

	shakerAnimationPlaying =
		false

	--==================================================
	-- NEW ANIMATIONS
	--==================================================

	humanoid.AnimationPlayed:Connect(
		function(track)

			if not isShakerAnimation(track) then
				return
			end

			shakerAnimationPlaying =
				true

			shakerStartCounter +=
				1

			local thisStart =
				shakerStartCounter

			shakerTracks[track] =
				true

			print(
				"[Poke Haven Mix Hub] Shaker STARTED #"
					.. tostring(thisStart)
			)

			track.Stopped:Connect(
				function()

					clearShakerTrack(
						track
					)

				end
			)

		end
	)

	--==================================================
	-- ALREADY PLAYING
	--==================================================

	for _, track in ipairs(
		humanoid:GetPlayingAnimationTracks()
	) do

		if isShakerAnimation(track) then

			shakerAnimationPlaying =
				true

			shakerTracks[track] =
				true

			print(
				"[Poke Haven Mix Hub] Existing shaker animation detected."
			)

			track.Stopped:Connect(
				function()

					clearShakerTrack(
						track
					)

				end
			)

		end

	end

end

