		if obj and obj.Parent then

			Event:FireServer(
				"Mix",
				obj,
				2
			)

		end

	end)

end

local function refreshMain()

	clearButtons(List)

	local search = SearchBox.Text:lower()
	local added = {}

	for _, obj in ipairs(Bottles:GetChildren()) do

		if obj
			and obj.Parent
			and not added[obj.Name] then

			if search == ""
				or obj.Name:lower():find(
					search,
					1,
					true
				) then

				added[obj.Name] = true
				addMainButton(obj)

			end

		end

	end

	for _, obj in pairs(selectedInstances) do

		if obj
			and obj.Parent
			and not added[obj.Name] then

			if search == ""
				or obj.Name:lower():find(
					search,
					1,
					true
				) then

				added[obj.Name] = true
				addMainButton(obj)

			end

		end

	end

	task.defer(function()

		List.CanvasSize = UDim2.new(
			0,
			0,
			0,
			ListLayout.AbsoluteContentSize.Y + 10
		)

	end)

end

