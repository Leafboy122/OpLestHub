local BottleCache = {}
local BottleNormalizedNames = {}

local function rebuildBottleCache()

	table.clear(BottleCache)
	table.clear(BottleNormalizedNames)

	for _, obj in ipairs(Bottles:GetDescendants()) do

		if obj:IsA("Model")
			or obj:IsA("BasePart")
			or obj:IsA("Tool")
			or obj:IsA("Folder") then

			table.insert(BottleCache, obj)

			BottleNormalizedNames[obj] =
				normalizeIngredient(obj.Name)

		end

	end

end

