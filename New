				Button.TextWrapped = true
				Button.ZIndex = 22
				Button.Parent = GlobalList

				Instance.new("UICorner", Button).CornerRadius =
					UDim.new(0, 6)

				Button.MouseButton1Click:Connect(function()

					if obj and obj.Parent then

						selectedInstances[
							obj:GetFullName()
						] = obj

						GlobalFrame.Visible = false

						refreshMain()

					end

				end)

			end

		end

	end

	task.defer(function()

		GlobalList.CanvasSize = UDim2.new(
			0,
			0,
			0,
			GlobalLayout.AbsoluteContentSize.Y + 10
		)

	end)

end

--==================================================
-- RECIPE LIST
--==================================================

local function refreshRecipes()

	clearButtons(RecipeList)

	local search =
		RecipeSearch.Text:lower()

	for recipeName, recipeData in pairs(Recipes) do

		local ingredients = recipeData.Ingredients
		local glassName = recipeData.Glass

		if search == ""
			or recipeName:lower():find(
				search,
				1,
				true
			) then

			local Button =
				Instance.new("TextButton")

			Button.Size =
				UDim2.new(1, -8, 0, 42)

			Button.BackgroundColor3 =
				Color3.fromRGB(30, 30, 30)

			-- RECIPE NAME + GLASS
			Button.Text =
				recipeName ..
				" [" ..
				tostring(glassName) ..
				"]"

			Button.TextColor3 =
				Color3.new(1, 1, 1)

			Button.TextSize = 12
			Button.Font = Enum.Font.GothamBold
			Button.TextXAlignment =
				Enum.TextXAlignment.Left

			Button.ZIndex = 32
			Button.Parent = RecipeList

			Instance.new("UICorner", Button).CornerRadius =
				UDim.new(0, 6)

			Button.MouseButton1Click:Connect(function()

				if Button:GetAttribute("Mixing") then
					return
				end

				Button:SetAttribute(
					"Mixing",
					true
				)

				Button.Text =
					recipeName ..
					" [" ..
					tostring(glassName) ..
					"] • Mixing..."

				task.spawn(function()

					for index, ingredientName
						in ipairs(ingredients) do

						local ingredient =
							findIngredient(
								ingredientName
							)

						if ingredient
							and ingredient.Parent then

							print(
								"[Poke Haven Mix Hub] Mixing:",
								ingredientName,
								"->",
								ingredient.Name
							)

							Event:FireServer(
								"Mix",
								ingredient,
								2
							)

						else

							warn(
								"[Poke Haven Mix Hub] Could not find:",
								ingredientName,
								"for",
								recipeName
							)

						end

						--==================================================
						-- 3 SECOND DELAY
						--==================================================

						if index < #ingredients then
							task.wait(MIX_DELAY)
						end

					end

					Button:SetAttribute(
						"Mixing",
						false
					)

					if Button.Parent then

						Button.Text =
							recipeName ..
							" [" ..
							tostring(glassName) ..
							"]"

					end

				end)

			end)

		end

	end

	task.defer(function()

		RecipeList.CanvasSize =
			UDim2.new(
				0,
				0,
				0,
				RecipeLayout.AbsoluteContentSize.Y + 10
			)

	end)

end

