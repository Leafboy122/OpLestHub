--==================================================
-- MODEL POSITION
--==================================================

local function getObjectPosition(obj)

	if not obj
		or not obj.Parent then

		return nil

	end

	if obj:IsA("BasePart") then

		return obj.Position

	end

	if obj:IsA("Model") then

		local primary =
			obj.PrimaryPart

		if primary then
			return primary.Position
		end

		local part =
			obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

		if part then
			return part.Position
		end

	end

	if obj:IsA("Tool") then

		local handle =
			obj:FindFirstChild(
				"Handle"
			)

		if handle
			and handle:IsA("BasePart") then

			return handle.Position

		end

		local part =
			obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

		if part then
			return part.Position
		end

	end

	return nil

end

--==================================================
-- NEARBY INGREDIENT MODEL SEARCH
--==================================================
-- Searches ONLY workspace.GameAssets.Interactables.Bottles
-- and only its direct Model children.
--
-- This is much lighter than workspace:GetDescendants()
-- because it never scans the whole game.
--
-- Picks the nearest matching Model within
-- INGREDIENT_SCAN_RADIUS studs of the player.

local function findNearbyIngredient(
	ingredientName
)

	local root =
		getRoot()

	if not root then
		return nil
	end

	local wanted =
		tostring(
			ingredientName
		)

	local best =
		nil

	local bestDistance =
		INGREDIENT_SCAN_RADIUS

	for _, model in ipairs(
		Bottles:GetChildren()
	) do

		if model:IsA("Model")
			and model.Name == wanted then

			local position =
				getObjectPosition(
					model
				)

			if position then

				local distance =
					(
						root.Position
						- position
					).Magnitude

				if distance <=
					bestDistance then

					bestDistance =
						distance

					best =
						model

				end

			end

		end

	end

	if best then

		print(
			"[Poke Haven Mix Hub] Nearby ingredient found:",
			wanted,
			"distance:",
			bestDistance
		)

	end

	return best

end

--==================================================
-- WALK TO INGREDIENT
--==================================================

local function walkToIngredient(
	ingredient
)

	if not walkToIngredients then
		return true
	end

	if not ingredient
		or not ingredient.Parent then

		return false

	end

	local humanoid =
		getHumanoid()

	local root =
		getRoot()

	if not humanoid
		or not root then

		return false

	end

	local startTime =
		os.clock()

	print(
		"[Poke Haven Mix Hub] Walking to:",
		ingredient.Name
	)

	while walkToIngredients
		and ingredient
		and ingredient.Parent do

		root =
			getRoot()

		humanoid =
			getHumanoid()

		if not root
			or not humanoid then

			return false

		end

		local position =
			getObjectPosition(
				ingredient
			)

		if not position then

			return false

		end

		local distance =
			(
				root.Position
				- position
			).Magnitude

		--==================================================
		-- 5 STUD STOP DISTANCE
		--==================================================

		if distance <=
			STOP_DISTANCE then

			humanoid:Move(
				Vector3.zero
			)

			print(
				"[Poke Haven Mix Hub] Reached",
				ingredient.Name,
				"within",
				STOP_DISTANCE,
				"studs."
			)

			return true

		end

		--==================================================
		-- KEEP WALKING
		--==================================================

		humanoid:MoveTo(
			position
		)

		-- Don't use a giant wait here.
		-- Keep checking the distance while walking.

		task.wait(
			0.1
		)

		-- Safety only for getting stuck while walking.
		if os.clock() - startTime >
			WALK_TIMEOUT then

			warn(
				"[Poke Haven Mix Hub] Walk timeout:",
				ingredient.Name
			)

			humanoid:Move(
				Vector3.zero
			)

			return false

		end

	end

	if humanoid then

		humanoid:Move(
			Vector3.zero
		)

	end

	return false

end

--==================================================
-- MIX ONE INGREDIENT
--==================================================
-- Returns:
-- true  = successfully handled
-- false = failed

local function mixIngredient(
	ingredientName
)

	--==================================================
	-- FIND INGREDIENT
	--==================================================

	local ingredient

	if walkToIngredients then

		ingredient =
			findNearbyIngredient(
				ingredientName
			)

	else

		ingredient =
			findIngredientExact(
				ingredientName
			)

	end

	if not ingredient
		or not ingredient.Parent then

		warn(
			"[Poke Haven Mix Hub] Could not find:",
			ingredientName
		)

		return false

	end

	--==================================================
	-- WALK
	--==================================================

	if walkToIngredients then

		local reached =
			walkToIngredient(
				ingredient
			)

		if not reached then

			warn(
				"[Poke Haven Mix Hub] Could not reach:",
				ingredientName
			)

			return false

		end

	end

	--==================================================
	-- WAIT IF SHAKER WAS ALREADY ACTIVE
	--==================================================

	waitForShakerIfActive()

	--==================================================
	-- RECORD SHAKER COUNTER
	--==================================================

	local shakerCounterBefore =
		shakerStartCounter

	--==================================================
	-- MIX
	--==================================================

	if ingredient
		and ingredient.Parent then

		print(
			"[Poke Haven Mix Hub] MIXING:",
			ingredientName
		)

		Event:FireServer(
			"Mix",
			ingredient,
			2
		)

	else

		return false

	end

	--==================================================
	-- IMPORTANT
	--==================================================
	--
	-- Give the game a chance to process the
	-- animation/event without waiting for it to
	-- start indefinitely.
	--
	-- The normal 2 second ingredient delay happens
	-- below.
	--
	-- If the shaker starts during this period,
	-- shakerStartCounter changes and we catch it.

	task.wait(
		BETWEEN_INGREDIENT_DELAY
	)

	--==================================================
	-- SHAKER STARTED AFTER MIX
	--==================================================
	--
	-- If the animation started after we sent the
	-- ingredient, wait for it to finish and retry
	-- the SAME ingredient.
	--
	-- This fixes cases like White Russian where
	-- the third ingredient can occasionally get
	-- skipped because the shaker starts late.

	if shakerStartCounter >
		shakerCounterBefore then

		print(
			"[Poke Haven Mix Hub] Shaker started AFTER",
			ingredientName,
			"was mixed."
		)

		print(
			"[Poke Haven Mix Hub] Waiting for shaker to finish..."
		)

		waitForShakerIfActive()

		--==================================================
		-- REFIND INGREDIENT
		--==================================================
		--
		-- The original object may have changed/moved
		-- while the shaker was running, so find it again.

		if walkToIngredients then

			ingredient =
				findNearbyIngredient(
					ingredientName
				)

		else

			ingredient =
				findIngredientExact(
					ingredientName
				)

		end

		if not ingredient
			or not ingredient.Parent then

			warn(
				"[Poke Haven Mix Hub] Could not refind ingredient for retry:",
				ingredientName
			)

			return false

		end

		--==================================================
		-- WALK AGAIN IF ENABLED
		--==================================================

		if walkToIngredients then

			local reached =
				walkToIngredient(
					ingredient
				)

			if not reached then

				return false

			end

		end

		--==================================================
		-- RETRY SAME INGREDIENT
		--==================================================

		waitForShakerIfActive()

		print(
			"[Poke Haven Mix Hub] RETRYING:",
			ingredientName
		)

		Event:FireServer(
			"Mix",
			ingredient,
			2
		)

		-- Give the retry the normal 2 second gap too.
		task.wait(
			BETWEEN_INGREDIENT_DELAY
		)

		-- If another shaker started during retry,
		-- wait for it before allowing the recipe
		-- to progress.

		waitForShakerIfActive()

	end

	return true

end

