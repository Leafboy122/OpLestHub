--==================================================
-- RECIPE MIX
--==================================================

local function startRecipeMix(
	recipeData,
	Button
)

	if Button:GetAttribute(
		"Mixing"
	) then

		return

	end

	Button:SetAttribute(
		"Mixing",
		true
	)

	local recipeName =
		recipeData.Name

	local ingredients =
		recipeData.Ingredients

	local glassName =
		recipeData.Glass

	Button.Text =
		recipeName
		.. " ["
		.. tostring(glassName)
		.. "] • Mixing..."

	task.spawn(
		function()

			local failed =
				false

			--==================================================
			-- EACH INGREDIENT IN RECIPE ORDER
			--==================================================

			for index, ingredientName in ipairs(
				ingredients
			) do

				print(
					"[Poke Haven Mix Hub] Recipe:",
					recipeName,
					"Step:",
					index,
					"/",
					#ingredients,
					ingredientName
				)

				local success =
					mixIngredient(
						ingredientName
					)

				if not success then

					failed =
						true

					break

				end

			end

			--==================================================
			-- FINISHED
			--==================================================

			Button:SetAttribute(
				"Mixing",
				false
			)

			if Button.Parent then

				if failed then

					Button.Text =
						recipeName
						.. " ["
						.. tostring(glassName)
						.. "] • Failed"

					task.wait(
						1
					)

				end

				if Button.Parent then

					Button.Text =
						recipeName
						.. " ["
						.. tostring(glassName)
						.. "]"

				end

			end

		end
	)

end

