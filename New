			break
		end

	end

end)

--==================================================
-- LEVENSHTEIN
--==================================================

local function levenshtein(a, b)

	local lenA = #a
	local lenB = #b

	if lenA == 0 then
		return lenB
	end

	if lenB == 0 then
		return lenA
	end

	local previous = {}

	for j = 0, lenB do
		previous[j] = j
	end

	for i = 1, lenA do

		local current = {}
		current[0] = i

		for j = 1, lenB do

			local cost =
				a:sub(i, i) == b:sub(j, j)
				and 0
				or 1

			current[j] = math.min(
				current[j - 1] + 1,
				previous[j] + 1,
				previous[j - 1] + cost
			)

		end

		previous = current

	end

	return previous[lenB]
end

local function similarity(a, b)

	if a == b then
		return 1
	end

	if a == "" or b == "" then
		return 0
	end

	if a:find(b, 1, true)
		or b:find(a, 1, true) then

		local shorter = math.min(#a, #b)
		local longer = math.max(#a, #b)

		return 0.90 + ((shorter / longer) * 0.10)
	end

	local distance = levenshtein(a, b)
	local longest = math.max(#a, #b)

	return 1 - distance / longest
end

--==================================================
-- SELECTED INSTANCES
--==================================================

local selectedInstances = {}

--==================================================
-- FIND BOTTLE
--==================================================

local function findIngredient(ingredientName)

	local wanted = normalizeIngredient(ingredientName)

	-- EXACT
	for _, obj in ipairs(BottleCache) do

		if obj and obj.Parent then

			local actual =
				BottleNormalizedNames[obj]

			if actual == wanted then

				print(
					"[Poke Haven Mix Hub] Exact:",
					ingredientName,
					"->",
					obj.Name
				)

				selectedInstances[obj:GetFullName()] = obj

				return obj
			end
		end
	end

	-- CONTAINS
	for _, obj in ipairs(BottleCache) do

		if obj and obj.Parent then

			local actual =
				BottleNormalizedNames[obj]

			if actual
				and (
					actual:find(wanted, 1, true)
					or wanted:find(actual, 1, true)
				) then

				print(
					"[Poke Haven Mix Hub] Similar:",
					ingredientName,
					"->",
					obj.Name
				)

				selectedInstances[obj:GetFullName()] = obj

				return obj
			end
		end
	end

	-- FUZZY
	local bestObject = nil
	local bestScore = 0

	for _, obj in ipairs(BottleCache) do

		if obj and obj.Parent then

			local actual =
				BottleNormalizedNames[obj]

			if actual then

				local score =
					similarity(wanted, actual)

				if #wanted >= 3
					and #actual >= 3 then

					local wantedPrefix =
						wanted:sub(
							1,
							math.min(4, #wanted)
						)

					local actualPrefix =
						actual:sub(
							1,
							math.min(4, #actual)
						)

					if wantedPrefix == actualPrefix then
						score += 0.08
					end
				end

				if score > bestScore then
					bestScore = score
					bestObject = obj
				end
			end
		end
	end

	if bestObject
		and bestScore >= 0.62 then

		print(
			"[Poke Haven Mix Hub] Fuzzy:",
			ingredientName,
			"->",
			bestObject.Name,
			math.floor(bestScore * 100) .. "%"
		)

		selectedInstances[bestObject:GetFullName()] =
			bestObject

		return bestObject
	end

	warn(
		"[Poke Haven Mix Hub] Missing ingredient:",
		ingredientName
	)

	return nil
end

