local function loadRecipeCategory(
	categoryName,
	glassName
)

	local category =
		RecipeLib.Recipes
		and RecipeLib.Recipes[categoryName]

	if not category then

		warn(
			"[Poke Haven Mix Hub] Category not found:",
			categoryName
		)

		return

	end

	for recipeName, ingredients in pairs(
		category
	) do

		if type(recipeName) == "string"
			and type(ingredients) == "table" then

			table.insert(
				Recipes,
				{
					Name = recipeName,
					Ingredients = ingredients,
					Glass = glassName
				}
			)

		end

	end

end

