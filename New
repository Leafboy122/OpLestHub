--==================================================
-- NORMALIZATION
--==================================================

local function normalizeName(name)

	name = tostring(name):lower()

	name = name:gsub("ä", "a")
	name = name:gsub("á", "a")
	name = name:gsub("à", "a")
	name = name:gsub("â", "a")

	name = name:gsub("é", "e")
	name = name:gsub("è", "e")
	name = name:gsub("ê", "e")

	name = name:gsub("í", "i")
	name = name:gsub("ì", "i")

	name = name:gsub("ó", "o")
	name = name:gsub("ò", "o")

	name = name:gsub("ú", "u")
	name = name:gsub("ù", "u")

	name = name:gsub("ñ", "n")

	name = name:gsub("&", "and")

	name = name:gsub("[^%w]", "")

	return name
end

local function normalizeIngredient(name)

	local normalized = normalizeName(name)

	if aliases[normalized] then
		normalized = aliases[normalized]
	end

	return normalized
end

