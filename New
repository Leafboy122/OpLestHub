--==================================================

local BottleCache =
	{}

local function rebuildBottleCache()

	table.clear(
		BottleCache
	)

	for _, obj in ipairs(
		Bottles:GetDescendants()
	) do

		if obj:IsA("Model")
			or obj:IsA("BasePart")
			or obj:IsA("Tool")
			or obj:IsA("Folder") then

			table.insert(
				BottleCache,
				obj
			)

		end

	end

end

rebuildBottleCache()

--==================================================
-- CACHE UPDATES
--==================================================

Bottles.DescendantAdded:Connect(
	function(obj)

		task.defer(
			function()

				if not obj.Parent then
					return
				end

				if obj:IsA("Model")
					or obj:IsA("BasePart")
					or obj:IsA("Tool")
					or obj:IsA("Folder") then

					for _, existing in ipairs(
						BottleCache
					) do

						if existing == obj then
							return
						end

					end

					table.insert(
						BottleCache,
						obj
					)

				end

			end
		)

	end
)

Bottles.DescendantRemoving:Connect(
	function(obj)

		for i = #BottleCache, 1, -1 do

			if BottleCache[i] == obj then

				table.remove(
					BottleCache,
					i
				)

				break

			end

		end

	end
)

--==================================================
-- EXACT INGREDIENT FINDER
--==================================================

local function findIngredientExact(
	ingredientName
)

	ingredientName =
		tostring(
			ingredientName
		)

	for _, obj in ipairs(
		BottleCache
	) do

		if obj
			and obj.Parent
			and obj.Name == ingredientName then

			selectedInstances[
				obj:GetFullName()
			] = obj

			print(
				"[Poke Haven Mix Hub] EXACT:",
				ingredientName,
				"->",
				obj:GetFullName()
			)

			return obj

		end

	end

	warn(
		"[Poke Haven Mix Hub] Ingredient not found:",
		ingredientName
	)

	return nil

end

