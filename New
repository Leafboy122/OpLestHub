--==================================================

local function loadRecipeCategory(categoryName, glassName)
	local category = RecipeLib.Recipes and RecipeLib.Recipes[categoryName]

	if not category then
		warn(
			"[Poke Haven Mix Hub] Recipe category not found:",
			categoryName
		)
		return
	end

	for recipeName, ingredients in pairs(category) do
		if type(ingredients) == "table" then
			Recipes[recipeName] = {
				Ingredients = ingredients,
				Glass = glassName
			}
		end
	end
end

